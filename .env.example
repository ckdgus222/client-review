# 영문과 숫자만 쓴다. 이 값이 DATABASE_URL 주소 안에 그대로 들어가는데,
# 특수문자는 주소를 깨거나 다른 글자로 바뀐다. 만들기: openssl rand -hex 24
POSTGRES_PASSWORD=changeme

# 맥에서 실행하는 api, Prisma 명령, api 테스트가 쓴다. 비밀번호를 위와 똑같이 적는다.
DATABASE_URL=postgresql://client_review:changeme@localhost:5434/client_review

# api 테스트가 쓰는 DB. 테스트는 표를 비우므로 개발 DB와 따로 둔다.
# DB 이름이 client_review_test가 아니면 테스트가 시작하지 않는다. 없으면 테스트가 처음 돌 때 만든다.
TEST_DATABASE_URL=postgresql://client_review:changeme@localhost:5434/client_review_test

# api가 쓰기 요청(POST 등)을 받아 줄 화면 주소. 쉼표로 나눈다. 없으면 api가 켜지지 않는다.
# 브라우저 주소창의 프로토콜·호스트·포트를 그대로 적고 끝에 /를 붙이지 않는다. 글자가 하나라도 다르면 403이다.
# 5173은 맥에서 켠 Vite, 8080은 Docker nginx다.
APP_ORIGINS=http://localhost:5173,http://localhost:8080

# 프로젝트를 만들 수 있는 개발자 이메일 하나. 다른 사람은 초대를 받아 클라이언트로만 들어온다.
# 비어 있으면 아무도 프로젝트를 만들 수 없다.
DEVELOPER_EMAIL=me@example.com

# 세션 쿠키를 https에서만 보낼지. 배포(https)에서 true로 켠다. 맥(http)에서는 적지 않는다.
# COOKIE_SECURE=true

# 운영 서버에서만 적는다(docker-compose.prod.yml이 읽는다). 맥에서는 적지 않는다.
# COMPOSE_FILE을 적어 두면 docker compose 명령과 deploy/ 스크립트가 늘 두 파일을 함께 읽는다.
# PUBLIC_URL은 고객이 브라우저에 적는 주소 하나다. 끝에 /를 붙이지 않는다. 운영에서는 APP_ORIGINS·APP_URL 대신 이 값을 쓴다.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# PUBLIC_URL=https://review.example.com

# 운영 서버의 백업·복원 스크립트(deploy/backup.sh, deploy/restore.sh)가 읽는다. 맥에서는 적지 않는다.
# BACKUP_DIR은 서버 안 백업 폴더, BACKUP_REMOTE는 서버 밖 보관 곳(rclone 대상 글자, 예: gdrive:client-review-backup),
# BACKUP_PASSPHRASE_FILE은 백업 암호 파일의 절대 경로다. 암호는 서버 밖에도 따로 둔다(서버를 잃으면 백업을 풀 수 없다).
# BACKUP_DIR=/mnt/backup/client-review
# BACKUP_REMOTE=
# BACKUP_PASSPHRASE_FILE=

# 사진 파일을 두는 폴더. 상대 경로는 api 폴더 기준이라 아래 값은 api/.assets다(git에 올리지 않는다).
# 비어 있으면 사진을 올리거나 받을 때 500이다. Docker에서는 이 값 대신 docker-compose.yml의 /data/assets(볼륨)를 쓴다.
ASSET_DIR=.assets

# 초대 메일 속 링크의 앞부분(브라우저로 여는 화면 주소). 끝에 /를 붙이지 않는다.
# 비어 있으면 초대 만들기가 500이다. 맥에서 켠 Vite는 5173, Docker는 docker-compose.yml이 8080을 넘긴다.
APP_URL=http://localhost:5173

# 메일 보내기. log는 보내지 않고 api 로그에 찍는다(로그인 코드도 그대로 찍힌다. 개발용).
# 배포에서는 smtp로 바꾸고 아래 다섯 값을 모두 넣는다. 하나라도 비면 api가 켜지지 않는다.
# 포트 465는 처음부터 TLS, 그 밖(587 등)은 STARTTLS를 꼭 쓴다.
MAIL_MODE=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# Docker Compose는 .env 값 안의 $를 변수로 읽는다. 비밀번호에 $가 있으면 값을 작은따옴표로 감싼다(SMTP_PASS='a$b').
# SMTP_PASS=
# 보내는 사람. 도메인에 SPF·DKIM·DMARC를 설정한 주소를 쓴다. 예: Client Review <noreply@example.com>
# MAIL_FROM=
