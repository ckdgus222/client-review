# 영문과 숫자만 쓴다. 이 값이 DATABASE_URL 주소 안에 그대로 들어가는데,
# 특수문자는 주소를 깨거나 다른 글자로 바뀐다. 만들기: openssl rand -hex 24
POSTGRES_PASSWORD=changeme

# 맥에서 실행하는 api, Prisma 명령, api 테스트가 쓴다. 비밀번호를 위와 똑같이 적는다.
DATABASE_URL=postgresql://client_review:changeme@localhost:5434/client_review

# api 테스트가 쓰는 DB. 테스트는 표를 비우므로 개발 DB와 따로 둔다.
# DB 이름이 client_review_test가 아니면 테스트가 시작하지 않는다. 없으면 테스트가 처음 돌 때 만든다.
TEST_DATABASE_URL=postgresql://client_review:changeme@localhost:5434/client_review_test

# api가 쓰기 요청(POST 등)을 받아 줄 화면 주소. 쉼표로 나눈다. 없으면 api가 켜지지 않는다.
# 브라우저 주소창의 프로토콜·호스트·포트를 그대로 적고 끝에 /를 붙이지 않는다. 글자가 하나라도 다르면 403이다.
# 5173은 맥에서 켠 Vite, 8080은 Docker nginx다.
APP_ORIGINS=http://localhost:5173,http://localhost:8080

# 세션 쿠키를 https에서만 보낼지. 배포(https)에서 true로 켠다. 맥(http)에서는 적지 않는다.
# COOKIE_SECURE=true
