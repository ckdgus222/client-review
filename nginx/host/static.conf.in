    location = / { try_files /index.html =404; }
    location = /privacy { try_files /privacy.html =404; }
    location = /terms { try_files /terms.html =404; }
    location = /app/demo { try_files /app/index.html =404; }
    location = /app/demo/ { try_files /app/index.html =404; }
    location = /favicon.svg { try_files $uri =404; }
    location = /app/favicon.svg { try_files $uri =404; }
    location = /landing.css { try_files $uri =404; }
    location = /robots.txt { try_files $uri =404; }
    location ~ ^/shop-[a-z0-9-]+\.webp$ { try_files $uri =404; }
    location ~ ^/(?:app/)?fonts/[a-zA-Z0-9._-]+\.woff2$ { try_files $uri =404; }
    location ~ ^/app/assets/[a-zA-Z0-9._-]+\.(?:js|css|webp)$ {
        root @RELEASE_ROOT@;
        try_files /current$uri /previous$uri =404;
    }
    location = /api/health { proxy_pass http://127.0.0.1:@API_PORT@/api/health; }
