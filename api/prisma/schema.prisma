generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // 만드는 방식을 환경에 맡기지 않고 고정한다. Prisma는 tsconfig.json을 보고 추측하는데,
  // Docker의 npm ci 때는 tsconfig.json이 아직 없어서 import에 .ts를 붙였고 빌드 결과가 실행되지 않았다.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  sessions  Session[]

  @@map("users")
}

model LoginCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  // 이 코드를 발급한 시각. 새 코드로 덮어쓸 때 함께 바꾸고, 60초 다시 보내기 검사에 쓴다.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("login_codes")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("sessions")
}
