generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // 만드는 방식을 환경에 맡기지 않고 고정한다. Prisma는 tsconfig.json을 보고 추측하는데,
  // Docker의 npm ci 때는 tsconfig.json이 아직 없어서 import에 .ts를 붙였고 빌드 결과가 실행되지 않았다.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String              @unique
  name              String
  // 마지막 접속 시각. 로그인할 때 적고, 세션을 쓸 때 5분에 한 번 고친다. 로그아웃으로 세션 줄이 지워져도 남는다.
  lastSeenAt        DateTime?           @map("last_seen_at") @db.Timestamptz
  // 마지막으로 개인정보 수집·이용에 동의하고 로그인한 시각(docs/landing.md 정할 것 6). 로그인할 때마다 적는다.
  privacyAgreedAt   DateTime?           @map("privacy_agreed_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  sessions          Session[]
  memberships       ProjectMember[]
  activities        ActivityEvent[]
  invitations       Invitation[]
  issues            Issue[]
  comments          Comment[]
  submittedAttempts ResolutionAttempt[] @relation("AttemptSubmitter")
  reviewedAttempts  ResolutionAttempt[] @relation("AttemptReviewer")
  approvals         Approval[]

  @@map("users")
}

model LoginCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  // 이 코드를 발급한 시각. 새 코드로 덮어쓸 때 함께 바꾸고, 60초 다시 보내기 검사에 쓴다.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // 동의하고 요청한 코드인가. 기본값 false라서 동의 기능 전에 만든 코드는 로그인에 쓸 수 없다.
  privacyAgreed Boolean @default(false) @map("privacy_agreed")

  @@map("login_codes")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("sessions")
}

enum ProjectRole {
  DEVELOPER
  CLIENT

  @@map("project_role")
}

enum Viewport {
  PC
  MOBILE

  @@map("viewport")
}

model Project {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  // 게시할 때만 바꾼다. 검수실이 처음 보여 줄 버전이다.
  currentVersionId String?           @unique @map("current_version_id") @db.Uuid
  currentVersion   DeliveryVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction)
  // 승인자는 이 프로젝트의 멤버만 될 수 있다. (승인자 id, 프로젝트 id) 두 칸을 멤버의 (id, project_id)에 걸어서
  // 다른 프로젝트의 멤버를 넣으면 DB가 거절한다. 역할이 CLIENT이고 철회되지 않았는지는 코드가 잠근 뒤 본다.
  approverMemberId String?           @map("approver_member_id") @db.Uuid
  approver         ProjectMember?    @relation("Approver", fields: [approverMemberId, id], references: [id, projectId], onDelete: NoAction)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  // 삭제 대기일 때만 되돌아갈 상태와 삭제한 시각이 있다. 셋이 함께 있거나 함께 없는 것은 마이그레이션의 CHECK가 지킨다.
  status             ProjectStatus  @default(ACTIVE)
  statusBeforeDelete ProjectStatus? @map("status_before_delete")
  deleteRequestedAt  DateTime?      @map("delete_requested_at") @db.Timestamptz
  members          ProjectMember[]
  screens          Screen[]
  versions         DeliveryVersion[]
  assets           Asset[]
  activities       ActivityEvent[]
  invitations      Invitation[]
  issues           Issue[]

  @@map("projects")
}

// 보관은 읽기만 하는 상태, 삭제 대기는 7일 뒤 정리 작업이 지우는 상태다(docs/archive.md).
enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETE_PENDING

  @@map("project_status")
}

// 개발자는 Project에 따로 적지 않고 여기 DEVELOPER 줄로만 적는다. 적는 곳이 하나라 두 값이 어긋나지 않는다.
// 프로젝트마다 DEVELOPER 줄이 1개인 것은 마이그레이션 SQL의 부분 유니크 인덱스가 지킨다. Prisma 스키마로는 미리보기 기능으로만 적을 수 있어서 SQL로 넣었다.
model ProjectMember {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String          @map("project_id") @db.Uuid
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String          @map("user_id") @db.Uuid
  user       User            @relation(fields: [userId], references: [id])
  role       ProjectRole
  // 접근을 철회하면 줄을 지우지 않고 시각만 적는다. 쓴 쪽지·댓글과 일지가 이 줄을 계속 가리킨다.
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz
  approverOf Project[]       @relation("Approver")
  activities ActivityEvent[] @relation("ActivityMember")

  @@unique([projectId, userId])
  // 승인자 외래키(Project.approver)가 가리킬 수 있게 (id, project_id)도 고유로 둔다.
  @@unique([id, projectId])
  // 내 프로젝트 목록은 user_id로만 찾는다. 위 유니크 인덱스는 첫 칸이 project_id라 이 조회에 거의 쓰이지 않는다.
  @@index([userId])
  @@map("project_members")
}

// 화면 이름표. 버전마다 사진을 이 이름표에 붙여서 1차와 2차의 같은 화면을 잇는다.
model Screen {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  viewport       Viewport
  // 숨겨도 줄은 지우지 않는다. 그래서 숨긴 이름표도 아래 유니크 제약에 걸려 같은 이름표가 둘이 되지 않는다.
  hiddenAt       DateTime?       @map("hidden_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  versionScreens VersionScreen[]

  @@unique([projectId, name, viewport])
  @@map("screens")
}

enum VersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED

  @@map("version_status")
}

// 초안은 number와 publishedAt이 비어 있고, 게시하면 둘 다 생긴다. 이 짝과 "초안은 프로젝트마다 1개"는
// 마이그레이션 SQL의 CHECK 제약과 부분 유니크 인덱스가 지킨다. CHECK는 Prisma 스키마로 적을 수 없고, 부분 유니크는 미리보기 기능으로만 적을 수 있어서 SQL로 넣었다.
model DeliveryVersion {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String              @map("project_id") @db.Uuid
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int?
  status      VersionStatus       @default(DRAFT)
  summary     String              @default("")
  testUrl     String?             @map("test_url")
  publishedAt DateTime?           @map("published_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  currentOf   Project?            @relation("CurrentVersion")
  screens     VersionScreen[]
  activities  ActivityEvent[]
  issues      Issue[]
  comments    Comment[]
  attempts    ResolutionAttempt[]
  approval    Approval?

  @@unique([projectId, number])
  // 쪽지의 외래키(Issue.originVersion)가 가리킬 수 있게 (id, project_id)도 고유로 둔다.
  @@unique([id, projectId])
  @@map("delivery_versions")
}

// 사진 파일 하나의 정보. 2차 초안이 1차 사진을 그대로 쓰면 같은 줄을 가리킨다.
model Asset {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageKey     String          @unique @map("storage_key")
  mime           String
  bytes          Int
  width          Int
  height         Int
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  versionScreens VersionScreen[]
  // 쪽지에 붙인 참고 사진이면 여기에 줄이 있다. 버전 화면의 사진과 달리 한 쪽지에만 붙는다.
  attachment     IssueAttachment?

  // 사진을 올릴 때마다 프로젝트 사진 용량 합계를 계산한다.
  @@index([projectId])
  @@map("assets")
}

// 버전의 화면 하나에 어떤 사진을 붙였는지. 화면과 사진은 NoAction이라 쓰이는 동안 DB가 지우기를 막는다.
// 이 검사는 마이그레이션 SQL에서 트랜잭션 끝으로 미룬다.
model VersionScreen {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String              @map("version_id") @db.Uuid
  version   DeliveryVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  screenId  String              @map("screen_id") @db.Uuid
  screen    Screen              @relation(fields: [screenId], references: [id], onDelete: NoAction)
  assetId   String              @map("asset_id") @db.Uuid
  asset     Asset               @relation(fields: [assetId], references: [id], onDelete: NoAction)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  issues    Issue[]
  attempts  ResolutionAttempt[]

  @@unique([versionId, screenId])
  // 쪽지와 고쳤어요 줄의 외래키(Issue.originVersionScreen, ResolutionAttempt.versionScreen)가 가리킬 수 있게 (id, version_id)도 고유로 둔다.
  @@unique([id, versionId])
  // 사진을 지우기 전에 다른 버전이 쓰는지 센다. 사진 줄을 지울 때 DB의 외래키 검사도 이 칸으로 찾는다.
  @@index([assetId])
  @@map("version_screens")
}

// 사건 종류는 기능마다 마이그레이션으로 값을 더한다.
enum ActivityType {
  VERSION_PUBLISHED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  MEMBER_REVOKED
  APPROVER_CHANGED
  ISSUE_CREATED
  ISSUE_STARTED
  RESOLUTION_SUBMITTED
  ISSUE_VERIFIED
  ISSUE_REOPENED
  ISSUE_WITHDRAWN
  VERSION_APPROVED
  PROJECT_ARCHIVED
  PROJECT_UNARCHIVED
  PROJECT_DELETE_REQUESTED
  PROJECT_RESTORED

  @@map("activity_type")
}

// 한 번 쓴 줄은 고치거나 지우지 않는다. 그래서 가리키는 버전도 NoAction으로 지우기를 막는다.
model ActivityEvent {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String                 @map("project_id") @db.Uuid
  project    Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String                 @map("actor_id") @db.Uuid
  actor      User                   @relation(fields: [actorId], references: [id])
  type       ActivityType
  versionId  String?                @map("version_id") @db.Uuid
  version    DeliveryVersion?       @relation(fields: [versionId], references: [id], onDelete: NoAction)
  // 초대 수락·접근 철회·승인자 변경의 대상 멤버. 초대 사건은 비워 둔다(초대 줄은 나중에 지워진다).
  memberId   String?                @map("member_id") @db.Uuid
  member     ProjectMember?         @relation("ActivityMember", fields: [memberId], references: [id], onDelete: NoAction)
  // 쪽지 작성·수정 시작·고쳤어요·확인 완료·다시 열기·철회의 대상 쪽지.
  issueId    String?                @map("issue_id") @db.Uuid
  issue      Issue?                 @relation(fields: [issueId], references: [id], onDelete: NoAction)
  // 줄을 쓰는 순간의 시각이다(clock_timestamp). now()는 트랜잭션을 시작한 시각이라, 먼저 시작했지만 프로젝트 잠금을
  // 늦게 얻은 요청이 더 이른 시각을 받는다. 기록 메일의 시각은 복원 때 다시 적용하는 순서라 실제 처리 순서와 같아야 한다.
  createdAt  DateTime               @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  deliveries NotificationDelivery[]

  // 활동 일지는 한 프로젝트의 줄을 최신순으로 읽는다. 찾기와 정렬을 인덱스 하나로 끝낸다.
  @@index([projectId, createdAt])
  @@map("activity_events")
}

// 프로젝트 초대. 링크 토큰은 해시만 둔다. 아직 쓰지 않은 초대가 (프로젝트, 이메일)마다 1개인 것과
// "수락과 무효가 함께 있을 수 없다"는 마이그레이션 SQL의 부분 유니크 인덱스와 CHECK 제약이 지킨다.
model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("invitations")
}

// 접수 → 수정 중 → 확인 요청 → 확인 완료. 철회는 끝나기 전 어디서든 되고, 끝난 쪽지(확인 완료·철회)는 다시 열면 접수로 돌아간다.
enum IssueStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_REVIEW
  VERIFIED
  WITHDRAWN

  @@map("issue_status")
}

enum IssueCategory {
  BUG
  DESIGN
  COPY
  OTHER

  @@map("issue_category")
}

// 하자 수정(계약 안)인지 추가 요청(계약 밖)인지. 추가 비용과 잔금 청구의 근거라서 개발자만 바꾼다.
enum IssueScope {
  IN_SCOPE
  OUT_OF_SCOPE

  @@map("issue_scope")
}

// 수정 요청 쪽지. 시작 버전·화면·핀 위치는 만든 뒤 바꾸지 않는다.
// 시작 버전은 이 프로젝트의 버전이고 시작 화면은 그 버전의 화면이라는 것을 두 칸짜리 외래키가 지킨다.
// "핀은 화면·x·y가 셋 다 있거나 셋 다 없다"와 "x·y는 0~1"은 마이그레이션 SQL의 CHECK 제약이 지킨다.
model Issue {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId             String              @map("project_id") @db.Uuid
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 프로젝트마다 1부터 붙인다. 프로젝트 줄을 잠근 뒤 "가장 큰 번호 + 1"로 정한다.
  number                Int
  // 쓸 때의 현재 버전. 위치 없는 쪽지에도 늘 있다.
  originVersionId       String              @map("origin_version_id") @db.Uuid
  originVersion         DeliveryVersion     @relation(fields: [originVersionId, projectId], references: [id, projectId], onDelete: NoAction)
  originVersionScreenId String?             @map("origin_version_screen_id") @db.Uuid
  originVersionScreen   VersionScreen?      @relation(fields: [originVersionScreenId, originVersionId], references: [id, versionId], onDelete: NoAction)
  // 사진 가로·세로에 대한 비율(0~1). 사진이 줄거나 커져도 같은 자리다.
  xRatio                Float?              @map("x_ratio")
  yRatio                Float?              @map("y_ratio")
  // 멤버 줄이 아니라 사용자를 가리킨다. 접근을 철회했다가 다시 들어와도 쓴 사람이 그대로다.
  authorId              String              @map("author_id") @db.Uuid
  author                User                @relation(fields: [authorId], references: [id])
  title                 String
  body                  String
  status                IssueStatus         @default(OPEN)
  category              IssueCategory       @default(BUG)
  scope                 IssueScope          @default(IN_SCOPE)
  // 시각 없는 날짜. 시각이 있으면 시간대에 따라 하루가 밀린다.
  dueDate               DateTime?           @map("due_date") @db.Date
  // 브라우저가 쓰기 칸을 열 때 만든 번호. 인터넷이 끊겨 다시 보내도 쪽지가 하나만 생긴다.
  requestId             String              @map("request_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz
  comments              Comment[]
  attachments           IssueAttachment[]
  activities            ActivityEvent[]
  attempts              ResolutionAttempt[]

  @@unique([projectId, number])
  @@unique([authorId, requestId])
  @@map("issues")
}

// createdAt의 기본값은 now()가 아니라 clock_timestamp()다. now()는 트랜잭션을 시작한 시각이라 프로젝트 줄 잠금을
// 기다린 만큼 이르게 적힌다. 댓글은 잠근 뒤에 넣으므로, 넣는 순간의 실제 시각이 "잠근 뒤의 시각"이 된다.
// 승인의 "승인 창을 연 뒤에 달린 댓글" 검사(7번)가 이 시각에 기댄다. 코드는 이 칸을 직접 적지 않는다.
model Comment {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId   String          @map("issue_id") @db.Uuid
  issue     Issue           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String          @map("author_id") @db.Uuid
  author    User            @relation(fields: [authorId], references: [id])
  // 쓸 때의 현재 버전. "2차 때 쓴 댓글"을 보여 준다.
  versionId String          @map("version_id") @db.Uuid
  version   DeliveryVersion @relation(fields: [versionId], references: [id], onDelete: NoAction)
  body      String
  // 사람이 쓴 댓글에는 늘 있다. 6번의 사유 댓글과 5-1번의 자동 댓글은 비워 둔다(유니크는 빈 값끼리 겹쳐도 막지 않는다).
  requestId String?         @map("request_id") @db.Uuid
  createdAt DateTime        @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz

  @@unique([authorId, requestId])
  // 쪽지의 댓글을 오래된 순으로 읽는다.
  @@index([issueId, createdAt])
  @@map("comments")
}

// 쪽지에 붙인 참고 사진. 사진 한 장은 쪽지 하나에만 붙는다.
model IssueAttachment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId   String   @map("issue_id") @db.Uuid
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  assetId   String   @unique @map("asset_id") @db.Uuid
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: NoAction)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // 쪽지의 사진을 읽고, 3장인지 센다.
  @@index([issueId])
  @@map("issue_attachments")
}

enum ResolutionResult {
  VERIFIED
  REOPENED

  @@map("resolution_result")
}

// 고쳤어요 한 번이 한 줄이다. 줄은 쌓이기만 하고, 결과(확인 완료·재요청)는 한 번만 적는다.
// 새 버전 게시나 철회로 답을 받지 못한 줄은 결과 없이 남는다.
// "결과·확인한 사람·확인 시각은 셋 다 있거나 셋 다 없다"는 마이그레이션 SQL의 CHECK 제약이 지킨다.
// 버전과 버전 화면의 외래키 검사는 쪽지처럼 트랜잭션 끝으로 미룬다(마이그레이션 SQL).
model ResolutionAttempt {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId         String            @map("issue_id") @db.Uuid
  issue           Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  // 고쳤어요를 보낼 때의 현재 버전.
  versionId       String            @map("version_id") @db.Uuid
  version         DeliveryVersion   @relation(fields: [versionId], references: [id], onDelete: NoAction)
  // 고친 결과를 볼 수 있는 화면. 그 버전의 화면이라는 것을 두 칸짜리 외래키가 지킨다. 위치 없는 쪽지는 비울 수 있다.
  versionScreenId String?           @map("version_screen_id") @db.Uuid
  versionScreen   VersionScreen?    @relation(fields: [versionScreenId, versionId], references: [id, versionId], onDelete: NoAction)
  summary         String
  submittedById   String            @map("submitted_by") @db.Uuid
  submittedBy     User              @relation("AttemptSubmitter", fields: [submittedById], references: [id])
  // 댓글처럼 잠근 뒤의 실제 시각을 DB가 적는다. 코드는 이 칸을 직접 적지 않는다.
  createdAt       DateTime          @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz
  result          ResolutionResult?
  reviewedById    String?           @map("reviewed_by") @db.Uuid
  // 기본값(SetNull)이면 사용자를 지울 때 이 칸만 비어서 "셋 다 있거나 셋 다 없다" CHECK에 걸린다. 보낸 사람처럼 지우기를 막는다.
  reviewedBy      User?             @relation("AttemptReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz

  // 쪽지의 줄을 오래된 순으로 읽고, 가장 최근 줄을 찾는다.
  @@index([issueId, createdAt])
  @@map("resolution_attempts")
}

// 버전의 승인 한 번이 한 줄이다. 버전마다 한 번만 승인할 수 있다(version_id 고유). 승인 취소는 없다.
// summary는 승인한 순간의 쪽지 목록이다. 승인 뒤에 쪽지가 바뀌어도 검수 확인서는 이 목록을 쓴다.
model Approval {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId  String          @unique @map("version_id") @db.Uuid
  version    DeliveryVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  approverId String          @map("approver_id") @db.Uuid
  approver   User            @relation(fields: [approverId], references: [id], onDelete: Restrict)
  // 댓글처럼 잠근 뒤의 실제 시각을 DB가 적는다. 코드는 이 칸을 직접 적지 않는다.
  approvedAt DateTime        @default(dbgenerated("clock_timestamp()")) @map("approved_at") @db.Timestamptz
  summary    Json

  @@map("approvals")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("delivery_status")
}

// 보낼 메일 우편함(아웃박스). 사건 줄과 같은 트랜잭션에서 받는 사람마다 한 줄을 넣고, api 안의 반복 작업이 꺼내 보낸다.
// 무슨 메일인지는 사건의 type에서 알아낸다. "시도 횟수 0~5"와 "SENT일 때만 보낸 시각"은 마이그레이션 SQL의 CHECK 제약이 지킨다.
model NotificationDelivery {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  event         ActivityEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  toEmail       String         @map("to_email")
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  // 다음에 보낼 시각. 보내는 동안에는 임대가 끝나는 시각이고, 실패하면 다시 보낼 시각이다.
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  // 같은 사건의 메일을 같은 사람에게 두 번 넣지 않는다.
  @@unique([eventId, toEmail])
  // 반복 작업이 "보낼 때가 된 PENDING 줄"을 찾는다.
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}
